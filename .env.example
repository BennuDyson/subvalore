# PostgreSQL connection
POSTGRES_DB=subvalore
POSTGRES_USER=subvalore
POSTGRES_PASSWORD=subvalore_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy database URL
DATABASE_URL=postgresql://subvalore:subvalore_secret@localhost:5432/subvalore

# Data freshness threshold in minutes
# Data older than this value will be considered stale and refreshed on next request
DATA_STALE_MINUTES=60

# App settings
APP_ENV=development
LOG_LEVEL=INFO
